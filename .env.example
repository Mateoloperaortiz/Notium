# Nombre visible de la aplicacion (header, titulo del documento).
VITE_APP_NAME=Notium
# Prefijo de todas las claves guardadas en LocalStorage.
VITE_STORAGE_PREFIX=notium
# Cambiar este numero regenera los datos ficticios en el navegador del cliente.
VITE_SEED_VERSION=1
# Escala de calificaciones de la institucion.
VITE_MAX_GRADE=5
VITE_MIN_GRADE=0
VITE_PASSING_GRADE=3
