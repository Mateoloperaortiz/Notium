# Copie este archivo como .env para correr la API en local. El .env no se versiona.
PORT=3000
SQLITE_PATH=database.sqlite
# Orígenes que pueden llamar a la API, separados por comas (dev server y vite preview).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Secreto para firmar los JWT: mínimo 32 caracteres. Genere uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
