ticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="368" y="106" width="36" height="20" as="geometry"/></mxCell><mxCell id="k17" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.2386;exitDx=0;exitDy=0;entryX=0;entryY=0.2386;entryDx=0;entryDy=0;" edge="1" parent="1" source="k5" target="k7"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="k18" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="698" y="106" width="24" height="20" as="geometry"/></mxCell><mxCell id="k19" value="0..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="758" y="106" width="36" height="20" as="geometry"/></mxCell><mxCell id="k20" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.2386;exitDx=0;exitDy=0;entryX=0;entryY=0.2143;entryDx=0;entryDy=0;" edge="1" parent="1" source="k7" target="k9"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="k21" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1088" y="106" width="24" height="20" as="geometry"/></mxCell><mxCell id="k22" value="0..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1148" y="106" width="36" height="20" as="geometry"/></mxCell><mxCell id="k23" value="" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=10;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k3" target="k10"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="k24" value="" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=10;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k5" target="k12"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="k25" value="Las entidades son interfaces planas de TypeScript en &lt;b&gt;src/interfaces/&lt;/b&gt;: se relacionan solo por ID (&lt;i&gt;userId&lt;/i&gt;, &lt;i&gt;semesterId&lt;/i&gt;, &lt;i&gt;subjectId&lt;/i&gt;) y no tienen métodos. Su CRUD está en &lt;i&gt;UserService&lt;/i&gt;, &lt;i&gt;SemesterService&lt;/i&gt;, &lt;i&gt;SubjectService&lt;/i&gt; y &lt;i&gt;GradeService&lt;/i&gt;.&lt;br&gt;&lt;br&gt;El rombo negro es composición: al borrar un registro se borran sus hijos en cascada. La línea punteada indica que la interfaz usa el enum.&lt;br&gt;&lt;br&gt;Todo se guarda como JSON en localStorage, por eso las fechas son texto ISO y las marcas de tiempo (&lt;i&gt;createdAt&lt;/i&gt;, &lt;i&gt;updatedAt&lt;/i&gt;) son números en milisegundos." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="800" y="330" width="660" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
